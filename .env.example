# Admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Auth.js session secret. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Timezone used for "today", statuses and reminder emails
APP_TIMEZONE=Asia/Dubai

# Database. Leave empty locally to use file:local.db. On Vercel use Turso (hosted SQLite).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Gmail SMTP. SMTP_PASSWORD is a Google App Password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL=

# Protects the daily reminder cron. Vercel sends it automatically as a bearer token.
CRON_SECRET=

# Optional. Adds an "Open Life Tracker" button to reminder emails. Vercel fills this in on its own.
APP_URL=

# Optional. Encrypts file transfer files and messages. Falls back to AUTH_SECRET.
# Changing it makes files already stored unreadable, so set it once.
TRANSFER_SECRET=

# Optional. Locks the site to your own devices. Everyone else gets a 404, except
# file transfer guest links and the cron. Generate with: openssl rand -hex 24
# Then open https://your-app/unlock/<DEVICE_KEY> once on each device you use.
DEVICE_KEY=

# Optional. Turns on the agent API at /api/mcp (an MCP server) so an AI assistant
# like Grok can read chats, reply and upload files. Generate with: openssl rand -hex 32
AGENT_API_KEY=
